<form class="contact-form" id="contact-form">
    <input type="hidden" name="access_key" value="ff5f576c-4d05-466a-af9d-4035f33d4445">
    <input type="hidden" name="subject" value="Enhance Ministries Website - New Contact Request Follow Up">
    <input type="hidden" name="from_name" value="Enhance Ministries Website">
    <input type="hidden" name="lead_source" id="lead-source-field" value="">
    <input type="checkbox" name="botcheck" style="display: none;" tabindex="-1" autocomplete="off">
    <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" autocomplete="name" required minlength="2" pattern="[A-Za-z\s\-'.]+">
    </div>
    <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required>
    </div>
    <div class="form-group">
        <label for="interest">I am interested in...</label>
        <select id="interest" name="interest" required>
            <option value="" selected disabled>Select what you're interested in</option>
            <option value="booking Matt to speak for an event">booking Matt to speak for my event</option>
            <option value="an Enhance mission experience">an Enhance mission experience</option>
            <option value="receiving coaching / consulting from Matt">receiving coaching / consulting from Matt</option>
            <option value="booking Matt to train my team">booking Matt to train my team</option>
            <option value="becoming a donor of Enhance Ministries">becoming a donor of Enhance Ministries</option>
            <option value="partnering my ministry with Enhance">partnering my ministry with Enhance</option>
            <option value="the golf event">the golf event</option>
            <option value="sponsoring a care event for pastors">sponsoring a care event for pastors</option>
            <option value="Other (specify below)">Other (specify below)</option>
        </select>
    </div>
    <div class="form-group" id="message-group">
        <label for="message">How can Matt help? <span class="form-optional">(optional)</span></label>
        <textarea id="message" name="message" rows="4" placeholder="Share a little context so Matt can follow up well."></textarea>
    </div>
    <button type="submit" class="btn btn-primary btn-block" id="submit-btn">Send Message to Matt</button>
    <p class="form-reassure">It takes about 30 seconds. Matt reads every message.</p>
    <div id="form-status" class="form-status"></div>
</form>
