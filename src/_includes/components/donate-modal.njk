<div id="donate-modal" class="modal">
    <div class="modal-content">
        <button class="modal-close" aria-label="Close">&times;</button>
        <iframe
            title="Donation form powered by Zeffy"
            src="{{ site.donateUrl }}"
            style="border: 0; width: 100%; height: 100%;">
        </iframe>
    </div>
</div>
<div class="mobile-cta-bar" role="navigation" aria-label="Quick actions">
    <a href="{{ '/index.html' | url }}#contact" class="btn btn-primary btn-sm mobile-connect-btn">Talk with Matt</a>
    <button class="btn btn-outline btn-sm" id="mobile-donate-btn">Donate</button>
</div>
